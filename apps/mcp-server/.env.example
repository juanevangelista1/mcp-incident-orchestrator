SENTRY_AUTH_TOKEN=seu_token_aqui
SENTRY_ORG_SLUG=sua_org_aqui

# Datadog é opcional — sem essas duas, só o plugin de logs fica desligado
DATADOG_API_KEY=sua_api_key_aqui
DATADOG_APP_KEY=sua_application_key_aqui
DATADOG_SITE=datadoghq.com

# APM tracing (dd-trace) é opcional — sem DD_AGENT_HOST, o tracer não inicializa e o
# processo roda normalmente, só sem enviar traces. Precisa de um Datadog Agent acessível
# no host/porta abaixo (não é a mesma coisa que a Logs API acima).
# DD_AGENT_HOST=10.221.4.82
# DD_TRACE_AGENT_PORT=8126
# DD_SERVICE=mcp-incident-orchestrator
# DD_ENV=production

# Clarity é opcional — sem essa, só o plugin de insights fica desligado
CLARITY_API_TOKEN=seu_token_aqui

# AWS CloudWatch Logs é opcional — sem essas, só o plugin de logs da AWS fica desligado
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
# Log group padrão usado quando a tool não informar um explicitamente
AWS_LOG_GROUP_NAME=/aws/lambda/sua-funcao-aqui
